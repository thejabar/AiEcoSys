<!--
  AiEcoSys Resource Dictionary - minimalist professional styles.
  Merged into Application.Resources so every view resolves the brushes and
  control styles even when the view is constructed before entering the tree.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colour palette -->
    <SolidColorBrush x:Key="WindowBackgroundBrush">#1e1e1e</SolidColorBrush>
    <SolidColorBrush x:Key="WindowForegroundBrush">#d4d4d4</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#252526</SolidColorBrush>
    <SolidColorBrush x:Key="CardForegroundBrush">#d4d4d4</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#0078d4</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverBrush">#1084d8</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#8c8c8c</SolidColorBrush>
    <SolidColorBrush x:Key="DividerBrush">#3a3a3c</SolidColorBrush>
    <SolidColorBrush x:Key="StatusBarDividerBrush">#3a3a3c</SolidColorBrush>

    <!-- Card style for statistic boxes -->
    <Style x:Key="CardStyle">
        <Setter Property="Border.Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Border.CornerRadius" Value="6" />
        <Setter Property="Border.Padding" Value="12" />
        <Setter Property="FrameworkElement.Margin" Value="4" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource WindowForegroundBrush}" />
    </Style>

    <!-- Card style for list rows (no fixed height cap) -->
    <Style x:Key="RowCardStyle">
        <Setter Property="Border.Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Border.CornerRadius" Value="6" />
        <Setter Property="Border.Padding" Value="10" />
        <Setter Property="FrameworkElement.Margin" Value="0,0,0,6" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource WindowForegroundBrush}" />
    </Style>

    <!-- Base button style for navigation buttons -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />

        <Style.Triggers>
            <Trigger Property="Button.IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>

            <Trigger Property="Button.IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>

            <Trigger Property="UIElement.IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBlock style for status displays -->
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- StatusBarItem style -->
    <Style x:Key="StatusBarItemStyle" TargetType="StatusBarItem">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ContentControl transition style -->
    <Style x:Key="ViewHostStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Dark theme DataGrid -->
    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="Foreground" Value="{StaticResource WindowForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource WindowForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WindowForegroundBrush}" />
        <Setter Property="RowBackground" Value="#252526" />
        <Setter Property="AlternatingRowBackground" Value="#2a2a2d" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#333335" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

</ResourceDictionary>
