<!-- Pricing View - token pricing from Models.dev metadata -->
<UserControl x:Class="AiEcoSys.Desktop.Views.PricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="Pricing Intelligence" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource WindowForegroundBrush}" />

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Price mode" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" Width="150" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding PriceModeItems}"
                          SelectedIndex="{Binding PriceModeSelectedIndex, Mode=TwoWay}" />

                <TextBlock Grid.Column="2" Text="Min input" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <ComboBox Grid.Column="3" Width="140" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding MinInputPriceItems}"
                          SelectedIndex="{Binding MinInputPriceSelectedIndex, Mode=TwoWay}" />

                <TextBlock Grid.Column="4" Text="Min output" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <ComboBox Grid.Column="5" Width="140" Height="28" HorizontalAlignment="Left"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding MinOutputPriceItems}"
                          SelectedIndex="{Binding MinOutputPriceSelectedIndex, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Table and summary -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding PricingSummaryText}" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" Margin="4,10,0,0" TextWrapping="Wrap" />

            <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}"
                      ItemsSource="{Binding PricingRecords}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="220" />
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="160" />
                    <DataGridTextColumn Header="Input $/1M" Binding="{Binding InputPriceDisplay}" Width="100" />
                    <DataGridTextColumn Header="Output $/1M" Binding="{Binding OutputPriceDisplay}" Width="110" />
                    <DataGridTemplateColumn Header="Price status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PriceStatus}" Foreground="{Binding PriceStatusColor}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
