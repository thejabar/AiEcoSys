<!-- Provider Manager View - provider metadata and connection checks -->
<UserControl x:Class="AiEcoSys.Desktop.Views.ProviderManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="Provider Manager" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource WindowForegroundBrush}" />

        <!-- Provider table -->
        <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Providers}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Provider" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="140" />
                <DataGridTextColumn Header="API endpoint" Binding="{Binding Api}" Width="240" />
                <DataGridTextColumn Header="Models" Binding="{Binding ModelCount}" Width="75" />
                <DataGridTemplateColumn Header="Credential" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CredentialStatus}"
                                       Foreground="{Binding CredentialStatusColor}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Test connection" Height="24" Padding="6,0"
                                    Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Test connection status -->
        <TextBlock Grid.Row="2" Text="{Binding TestConnectionStatus}" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" Margin="4,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
