<!-- Model Explorer View - search and filter the catalogue models -->
<UserControl x:Class="AiEcoSys.Desktop.Views.ModelExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="Model Explorer" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource WindowForegroundBrush}" />

        <!-- Search and filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Search" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Modality" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox Grid.Row="0" Grid.Column="3" Width="160" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ModalityItems}"
                          SelectedIndex="{Binding ModalitySelectedIndex, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max context" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,8,8,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="160" Height="28" HorizontalAlignment="Left"
                          Margin="0,8,0,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ContextItems}"
                          SelectedIndex="{Binding ContextSelectedIndex, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ModelSummaryText}"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <!-- Model table -->
        <Grid Grid.Row="2">
            <DataGrid Style="{StaticResource DataGridStyle}"
                      ItemsSource="{Binding FilteredModels}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="150" />
                    <DataGridTextColumn Header="Context" Binding="{Binding ContextDisplay}" Width="90" />
                    <DataGridTextColumn Header="Input $/1M" Binding="{Binding InputPriceDisplay}" Width="95" />
                    <DataGridTextColumn Header="Output $/1M" Binding="{Binding OutputPriceDisplay}" Width="100" />
                    <DataGridTextColumn Header="Tool calls" Binding="{Binding ToolCallingDisplay}" Width="80" />
                    <DataGridTextColumn Header="Modalities" Binding="{Binding ModalitiesDisplay}" Width="180" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No models match the search criteria." FontSize="14"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredModels.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
