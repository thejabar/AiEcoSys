<!-- About View - application name, version, build information, licence information, project links -->
<UserControl x:Class="AiEcoSys.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="About AiEcoSys" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource WindowForegroundBrush}" />

        <!-- About content -->
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">
                <!-- Application identity -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AiEcoSys" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="AI Ecosystem Management Platform" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Copyright (c) 2026 thejabar" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="A minimalist professional Windows desktop application for AI model and provider management."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Build information -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Build Information" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding BuildConfiguration, StringFormat=Configuration: {0}}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding RuntimeDescription, StringFormat=Runtime: {0}}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="Target framework: net10.0-windows" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="UI: Windows Presentation Foundation (WPF)" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Licence information -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Licence" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="MIT Licence" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Copyright (c) 2026 thejabar" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Permission is granted to use, copy, modify, and distribute this software under the terms of the MIT Licence."
                                   FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Project links -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Project Links" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="GitHub Repository" Width="140" Height="28" Margin="0,0,8,0"
                                    Command="{Binding OpenProjectLinkCommand}" />
                            <Button Content="Documentation" Width="130" Height="28"
                                    Command="{Binding OpenDocumentationCommand}" />
                        </StackPanel>
                        <TextBlock Text="https://github.com/thejabar/AiEcoSys" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="https://github.com/thejabar/AiEcoSys/blob/main/docs" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Feature list -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Features" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="• Model Explorer - search and filter catalogue models" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="• Provider Manager - provider metadata and connection checks" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="• Pricing Intelligence - token pricing from catalogue metadata" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="• Model Selection - filter models by task, provider, modality, context and price" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="• Catalogue Manager - offline snapshot and online refresh" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="• Integrations - opt-in AcademyOS, UBOS and MavenMeeM endpoints" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="• Security - Windows Credential Manager storage and HTTPS enforcement" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
