<!-- Catalogue View - displays provider and model catalogue records -->
<UserControl x:Class="AiEcoSys.Desktop.Views.CatalogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="Catalogue Manager" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource WindowForegroundBrush}" />

        <!-- Status bar -->
        <Border Grid.Row="1" Style="{StaticResource RowCardStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#c8a338" />
                    <TextBlock Text="{Binding DataSourceText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DataTimestampText, StringFormat=Source data: {0}}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding RegistryProviderCount, StringFormat={}{0} providers}"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding RegistryModelCount, StringFormat={}{0} models}"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Refresh from snapshot" Width="160" Height="28" Margin="0,0,0,6"
                            Command="{Binding RefreshFromSnapshot}" />
                    <Button Content="Save snapshot" Width="160" Height="28"
                            Command="{Binding SaveSnapshotCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search and snapshot status -->
        <Grid Grid.Row="2" Margin="4,10,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Search" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                     Text="{Binding CatalogueSearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding SnapshotStatusText}" FontSize="10"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                       Margin="10,0,0,0" MaxWidth="320" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Catalogue records -->
        <DataGrid Grid.Row="3" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding FilteredCatalogueRecords}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="170" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="260" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
