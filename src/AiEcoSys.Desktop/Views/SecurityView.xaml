<!-- Security View - security configuration and credential management -->
<UserControl x:Class="AiEcoSys.Desktop.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="Security" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource WindowForegroundBrush}" />

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Security status -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Security Status" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SecurityStatusText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- HTTPS enforcement -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="HTTPS Enforcement" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding HttpsStatusText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Credential management -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Credential Management" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Secrets are stored in the Windows Credential Manager for the current user. They are never written to disk by AiEcoSys."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Provider" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                     Text="{Binding CredentialTarget, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="Secret" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <PasswordBox x:Name="CredentialValueBox" Grid.Column="3" Height="28"
                                         VerticalContentAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Store credential" Width="130" Height="28" Margin="0,0,8,0"
                                    Click="StoreCredential_Click" />
                            <Button Content="Delete credential" Width="130" Height="28"
                                    Command="{Binding DeleteCredentialCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding CredentialStatusText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Audit events -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Security Events" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SecurityEventsText}" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
