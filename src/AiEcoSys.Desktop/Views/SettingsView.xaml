<!-- Settings View - application settings with configurable data/snapshot locations -->
<UserControl x:Class="AiEcoSys.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource WindowForegroundBrush}" />

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Data location -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Data Location" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Absolute path on a non-C: drive. Project files and user data must stay off the C: drive."
                                   FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="320" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                     Text="{Binding DataLocation, Mode=TwoWay}" />
                            <Button Content="Save location" Width="120" Height="28"
                                    Command="{Binding SaveDataLocationCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DataLocationStatusText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Snapshot location -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Snapshot Location" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Directory used for catalogue snapshots. Must be inside the application data directory."
                                   FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="320" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                     Text="{Binding SnapshotLocation, Mode=TwoWay}" />
                            <Button Content="Save location" Width="120" Height="28"
                                    Command="{Binding SaveSnapshotLocationCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SnapshotLocationStatusText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <Border Style="{StaticResource RowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Behaviour" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource WindowForegroundBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Offline mode (disable online API calls)" IsChecked="{Binding OfflineMode, Mode=TwoWay}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Automatically refresh catalogue on launch" IsChecked="{Binding AutoSyncOnLaunch, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
