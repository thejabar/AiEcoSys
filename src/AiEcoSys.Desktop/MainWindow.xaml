<!--
  AiEcoSys Main Window - minimalist professional WPF shell window.
  Follows MVVM pattern with clean navigation.
-->
<Window x:Class="AiEcoSys.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AiEcoSys.Desktop"
        mc:Ignorable="d"
        Title="AiEcoSys - AI Ecosystem Management Platform"
        Height="720"
        Width="1280"
        MinHeight="480"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#1e1e1e"
        Foreground="#d4d4d4"
        TextElement.Foreground="#d4d4d4">

    <Grid>
        <!-- Grid row definitions: navigation pane + content area -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Top bar: title and status -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#252526">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App title -->
            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="AiEcoSys" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="AI Ecosystem Management Platform" FontSize="10" Opacity="0.7" />
            </StackPanel>

            <!-- Central status area -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,0,0,2" />
                <TextBlock Text="{Binding LastSyncText, StringFormat=Last sync: {0}}" FontSize="9" Opacity="0.5" />
            </StackPanel>

            <!-- App actions -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Content="↻" FontSize="12" Width="32" Height="32"
                        Command="{Binding RefreshOnline}"
                        ToolTip="Refresh catalogue from Models.dev"
                        Margin="0,0,8,0"
                        Background="Transparent" BorderBrush="Transparent" />
            </StackPanel>
        </Grid>

        <!-- Navigation pane (left side) -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,8,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Style="{StaticResource NavButtonStyle}"
                                Command="{Binding Command}"
                                CommandParameter="{Binding ViewKey}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Content area - shows the selected view -->
        <ContentControl Grid.Row="1" Grid.Column="1" Margin="12,0,0,0"
                        Content="{Binding CurrentView}" />

        <!-- Bottom status bar -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="#252526" Foreground="#d4d4d4">
            <StatusBarItem>
                <TextBlock Text="{Binding AppVersion, StringFormat=AiEcoSys v{0}}" FontSize="9" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding DataSourceText}" FontSize="9" Margin="10,0,0,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ApiStatusText}" FontSize="9" Margin="10,0,0,0" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding RegistryProviderCount, StringFormat={}{0} providers}" FontSize="9" Margin="10,0,0,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding RegistryModelCount, StringFormat={}{0} models}" FontSize="9" Margin="10,0,0,0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
