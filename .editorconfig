root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,sln,cs,xaml,axaml}]
indent_size = 4

[*.{json,yml,yaml,xml,config,ps1}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ico,png,pdf,exe,msi,iso,dll,so,dylib}]
binary = true
